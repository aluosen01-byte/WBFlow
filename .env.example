# Wildberries China API token (个人访问令牌)
# 从 https://dev.wildberries.cn/company 或卖家后台生成，切勿提交到git仓库
# 需要 Content（商品管理）权限；建议同时开通 Prices / Marketplace

# 单用户模式：默认用户令牌（未配置 WB_USERS 时使用）
WB_TOKEN=粘贴你的令牌

# 团队多用户模式（推荐）：JSON 对象 {"用户名":"令牌",...}
# 服务端按请求头 X-WB-User 切换账号，前端（网页/扩展）选择用户后自动携带
# 支持服务令牌：值可改为 {"用户名":{"token":"...","clientSecret":"..."}}，
#   clientSecret 用于 "for":"asid:*" 的服务令牌（调用内容API需 X-Client-Secret 头）
# WB_USERS={"张三":"令牌1","李四":{"token":"令牌2","clientSecret":"可选"}}

# 服务端口
PORT=3000

# 可选：自定义网关与语言（默认即可）
# CONTENT_BASE=https://content-api.wildberries.cn
# MARKET_BASE=https://marketplace-api.wildberries.cn
# PRICES_BASE=https://discounts-prices-api.wildberries.cn
# LOCALE=zh
